# Naledi — settings needed when running on your own Supabase project and Vercel.
# Copy to .env for local development; add the same names in Vercel > Settings > Environment Variables.

# --- Browser (safe to expose) ---
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your anon / publishable key>

# --- Server only (never expose) ---
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<your anon / publishable key>
SUPABASE_SERVICE_ROLE_KEY=<your service role key>

# AI provider (one of these). GEMINI_API_KEY is used first when present.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Only if you keep using the Lovable AI gateway:
LOVABLE_API_KEY=

# Live multilingual speech uses GEMINI_API_KEY above.
# Keep the current live agent's voice for English/Afrikaans with these server-only settings.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Shared secret for the voice agent tool endpoints
AGENT_TOOL_TOKEN=

# Shared secret for the scheduled crawl and snapshot endpoints
CRAWL_TOKEN=
# Vercel sets CRON_SECRET itself; the scheduled endpoints accept it too.
CRON_SECRET=

# Approved media-response email, server only. Use a verified bare sender address
# or a formatted mailbox such as '"Naledi" <noreply@example.com>'.
# RESEND_KEY and RESEND_FROM are accepted aliases; non-empty canonical names below take precedence.
RESEND_API_KEY=
MEDIA_EMAIL_FROM=

# Build target for Vercel (set in the Vercel project, not needed locally)
NITRO_PRESET=vercel
